    "/payments": {
      "get": {
        "description": "List payments for the authenticated merchant, newest first.",
        "operationId": "list_payments",
        "parameters": [
          {
            "description": "Filter by exact lifecycle status, e.g. `captured`.",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Only payments created strictly after this RFC3339 timestamp.",
            "in": "query",
            "name": "created_after",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Max rows to return, default 10.",
            "in": "query",
            "name": "limit",
