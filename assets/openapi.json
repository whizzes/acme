              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentList"
                }
              }
            },
            "description": "Page of payments, newest first"
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ],
        "tags": [
          "payments"
        ]
      },
      "post": {
        "description": "Create and, depending on the resolved scenario, immediately capture a payment (spec §9.1).",
        "operationId": "create_payment",
        "parameters": [
          {
            "description": "Client-supplied key; a repeated key with the same body replays the stored response instead of charging twice",
            "in": "header",
            "name": "Acme-Idempotency-Key",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "examples": {
                "approved": {
                  "summary": "Card that will be approved",
                  "value": {
                    "amount": 4599000,
                    "currency": "CLP",
                    "payment_method": {
                      "card": {
                        "cvv": "123",
                        "exp_month": 11,
                        "exp_year": 2029,
                        "holder": "CAMILA FUENTES",
                        "number": "4111111111111111"
                      },
                      "type": "card"
                    },
                    "reference": "ORD-2026-000814"
                  }
                },
                "declined": {
                  "summary": "Insufficient funds",
                  "value": {
                    "amount": 4599000,
                    "currency": "CLP",
                    "payment_method": {
                      "card": {
                        "exp_month": 11,
                        "exp_year": 2029,
                        "number": "4000000000000002"
                      },
                      "type": "card"
                    }
                  }
                }
              },
              "schema": {
                "$ref": "#/components/schemas/CreatePaymentRequest"
              }
            }
          },
          "description": "Payment to create",
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Payment"
                }
              }
            },
            "description": "Payment created"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcmeErrorBody"
                }
              }
            },
            "description": "Request failed validation, e.g. an invalid card number"
          },
          "402": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcmeErrorBody"
                }
              }
            },
            "description": "Payment declined"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcmeErrorBody"
                }
              }
            },
            "description": "Idempotency key reused with a different request body, or a request with the same key is still in flight"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcmeErrorBody"
                }
              }
            },
            "description": "Simulated provider error (spec §9.1 magic value)"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcmeErrorBody"
                }
              }
            },
            "description": "Simulated processing error (spec §9.1 magic value)"
          }
        },
        "security": [
          {
            "bearer_token": []
          }
        ],
        "tags": [
          "payments"
        ]
      }
    },
